<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Known bugs: các test phát hiện bug của hệ thống (BUG-007..011). Dự kiến FAIL cho tới khi dev sửa bug.
     CI chạy bộ này nhưng không chặn build; kết quả vẫn có trong Allure report. -->
<suite name="Bookstore Known Bugs" parallel="methods" thread-count="2" data-provider-thread-count="2">
    <test name="KnownBugs">
        <groups>
            <run>
                <include name="known-bug"/>
            </run>
        </groups>
        <packages>
            <package name="com.bookstore.tests"/>
        </packages>
    </test>
</suite>
